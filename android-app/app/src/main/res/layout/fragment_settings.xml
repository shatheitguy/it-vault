<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/SectionLabel" android:text="APPEARANCE" android:layout_marginTop="0dp" />
        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/themeSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Follow system"
                android:textColor="@color/text"
                android:buttonTint="@color/accent" />
            <RadioButton
                android:id="@+id/themeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Light"
                android:textColor="@color/text"
                android:buttonTint="@color/accent" />
            <RadioButton
                android:id="@+id/themeDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Dark"
                android:textColor="@color/text"
                android:buttonTint="@color/accent" />
        </RadioGroup>

        <TextView style="@style/SectionLabel" android:text="APP ICON" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="12.5sp"
            android:textColor="@color/muted"
            android:text="Android compiles the launcher icon into the app, so it cannot become your uploaded logo. Pick one of these, or pin a shortcut that does carry your logo." />
        <RadioGroup
            android:id="@+id/iconGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/iconDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:text="Shield — the red tile" />
            <RadioButton
                android:id="@+id/iconLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:text="Light — the crest on white" />
            <RadioButton
                android:id="@+id/iconMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:text="Mono — greyscale on near-black" />
        </RadioGroup>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pinBrandBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Add a home-screen shortcut with your logo"
            android:textColor="@color/accent"
            app:strokeColor="@color/accent"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView style="@style/SectionLabel" android:text="MY ACCOUNT" />
        <com.google.android.material.textfield.TextInputLayout style="@style/DarkInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Display name">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/displayInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/DarkInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Email">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/emailInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/saveProfileBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:backgroundTint="@color/accent" android:text="Save profile" />

        <TextView style="@style/SectionLabel" android:text="CHANGE PASSWORD" />
        <com.google.android.material.textfield.TextInputLayout style="@style/DarkInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Old password">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/oldPassInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:textColor="@color/text" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/DarkInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="New password">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/newPassInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:textColor="@color/text" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/changePassBtn" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Update password" android:textColor="@color/accent" app:strokeColor="@color/accent" xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/settingsMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <TextView style="@style/SectionLabel" android:text="OFFLINE &amp; SYNC" />
        <TextView
            android:id="@+id/syncStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:background="@color/surface"
            android:padding="12dp"
            android:text="All changes synced" />
        <com.google.android.material.button.MaterialButton android:id="@+id/syncNowBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:backgroundTint="@color/accent" android:text="Sync now" />
        <com.google.android.material.button.MaterialButton android:id="@+id/exportXmlBtn" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Export data as XML" android:textColor="@color/accent" app:strokeColor="@color/accent" xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView style="@style/SectionLabel" android:text="SERVER" />
        <TextView
            android:id="@+id/serverText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:background="@color/surface"
            android:padding="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/changeServerBtn" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Change server / Logout" android:textColor="@color/accent" app:strokeColor="@color/accent" xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView style="@style/SectionLabel" android:text="APP UPDATES" />
        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:background="@color/surface"
            android:padding="12dp"
            android:text="Version" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkUpdateBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/accent"
            android:text="Check for updates" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="IT-Vault — self-hosted · offline sync"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
