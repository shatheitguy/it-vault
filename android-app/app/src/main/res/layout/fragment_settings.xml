<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings, as cards rather than a scroll of labels.

  It was one long column: orange capitals, radio buttons, outlined fields and
  full-width buttons, with nothing to say where one subject ended and the next
  began. Each subject is now a card with a plain heading, the theme choice is
  a row of pills like the reference's filters, and the only buttons that stay
  filled are the ones you actually press.

  Every id the fragment binds is unchanged.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="28dp">

        <!-- ===================== appearance ===================== -->
        <TextView style="@style/TitleM" android:text="Appearance" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/BodySoft"
                    android:layout_width="match_parent"
                    android:text="How the app follows the light and dark themes." />

                <RadioGroup
                    android:id="@+id/themeGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/themeSystem"
                        style="@style/Pill"
                        android:button="@null"
                        android:text="System" />

                    <RadioButton
                        android:id="@+id/themeLight"
                        style="@style/Pill"
                        android:button="@null"
                        android:text="Light" />

                    <RadioButton
                        android:id="@+id/themeDark"
                        style="@style/Pill"
                        android:button="@null"
                        android:text="Dark" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== account ===================== -->
        <TextView style="@style/TitleM" android:layout_marginTop="22dp" android:text="My account" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Display name">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/displayInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Email">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveProfileBtn"
                    style="@style/ButtonPill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Save profile" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== password ===================== -->
        <TextView style="@style/TitleM" android:layout_marginTop="22dp" android:text="Change password" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Old password">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/oldPassInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="New password">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/newPassInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/changePassBtn"
                    style="@style/ButtonPillQuiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Update password" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/settingsMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_soft"
            android:padding="12dp"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- ===================== offline and sync ===================== -->
        <TextView style="@style/TitleM" android:layout_marginTop="22dp" android:text="Offline &amp; sync" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/syncStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="All changes synced"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/syncNowBtn"
                        style="@style/ButtonPill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Sync now" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/exportXmlBtn"
                        style="@style/ButtonPillQuiet"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Export XML" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== server ===================== -->
        <TextView style="@style/TitleM" android:layout_marginTop="22dp" android:text="Server" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/serverText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/changeServerBtn"
                    style="@style/ButtonPillQuiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Change server / sign out" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== updates ===================== -->
        <TextView style="@style/TitleM" android:layout_marginTop="22dp" android:text="App updates" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/versionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Version"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkUpdateBtn"
                    style="@style/ButtonPill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Check for updates" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="IT-Vault — self-hosted · offline sync" />
    </LinearLayout>
</ScrollView>
