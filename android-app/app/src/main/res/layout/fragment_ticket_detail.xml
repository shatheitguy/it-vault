<?xml version="1.0" encoding="utf-8"?>
<!--
  One ticket.

  Three cards on the page — what was asked, what state it is in, what was said
  back — over a reply bar pinned to the bottom. It used to be a column of
  loose text with a grey spinner in the middle of it, so there was nothing to
  say where the question ended and the conversation began.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- ====================== what was asked ====================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_marginTop="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tSubject"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_strong"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tStatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/pill_idle"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textColor="@color/chip_idle_text"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_soft"
                        android:textSize="12.5sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/tDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.25"
                        android:textColor="@color/text_strong"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========================= its state ========================= -->
            <TextView style="@style/SectionLabel" android:text="Status" />

            <com.google.android.material.card.MaterialCardView style="@style/Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <Spinner android:id="@+id/tStatus" style="@style/Dropdown" />

                    <TextView
                        style="@style/Caption"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:text="Changing this saves straight away, and the person who raised it is told." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================== the replies ======================== -->
            <TextView style="@style/SectionLabel" android:text="Replies" />

            <com.google.android.material.card.MaterialCardView style="@style/Card">
                <LinearLayout
                    android:id="@+id/repliesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- ========================== the reply bar ========================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Write a reply…">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/replyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:textColor="@color/text_strong" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendReplyBtn"
            style="@style/ButtonPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minWidth="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="Send" />
    </LinearLayout>
</LinearLayout>
