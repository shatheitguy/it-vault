<?xml version="1.0" encoding="utf-8"?>
<!--
  Adding or editing an asset.

  It was one unbroken column of twenty controls on a flat background, with
  accent-coloured capitals every so often to say a new subject had started.
  The subjects are cards now, so the boundary is something you can see rather
  than something you have to read, and a spinner looks like the fields it sits
  between instead of a grey bar.

  Every id the fragment binds is unchanged.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="32dp">

        <!-- ======================= department ======================= -->
        <LinearLayout
            android:id="@+id/spaceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView style="@style/SectionLabel" android:layout_marginTop="4dp" android:text="Department" />
            <com.google.android.material.card.MaterialCardView style="@style/Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <com.itguy.assetmanager.ui.widget.AppSpinner android:id="@+id/f_Space" style="@style/Dropdown" />
                    <TextView
                        android:id="@+id/spaceNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ========================= identity ========================= -->
        <TextView style="@style/SectionLabel" android:layout_marginTop="4dp" android:text="Identity" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Asset ID">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/f_AssetTag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Asset name">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/f_Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView style="@style/FieldLabel" android:text="Item category" />
                <com.itguy.assetmanager.ui.widget.AppSpinner android:id="@+id/f_Type" style="@style/Dropdown" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Serial">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/f_Serial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="MAC address">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/f_MacAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView style="@style/FieldLabel" android:text="Location" />
                <com.itguy.assetmanager.ui.widget.AppSpinner android:id="@+id/f_Location" style="@style/Dropdown" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== extra fields of this department + category ========== -->
        <LinearLayout
            android:id="@+id/extraSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/extraTitle" style="@style/SectionLabel" android:text="Details" />
            <com.google.android.material.card.MaterialCardView style="@style/Card">
                <LinearLayout
                    android:id="@+id/extraBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="18dp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ==================== manufacturer and model ==================== -->
        <TextView style="@style/SectionLabel" android:text="Manufacturer &amp; model" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Manufacturer" />
                <com.itguy.assetmanager.ui.widget.AppSpinner android:id="@+id/f_Manufacturer" style="@style/Dropdown" />

                <TextView style="@style/FieldLabel" android:text="Model" />
                <com.itguy.assetmanager.ui.widget.AppSpinner android:id="@+id/f_Model" style="@style/Dropdown" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== photo ==================== -->
        <!-- The asset's own photo, or the one it shows from its model in the
             Product Catalog: the same picture as in the list and on the web. -->
        <TextView style="@style/SectionLabel" android:text="Photo" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <FrameLayout
                    android:id="@+id/photoTile"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginEnd="16dp">

                    <ImageView
                        android:id="@+id/photoIcon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_t_box" />

                    <ImageView
                        android:id="@+id/photoImg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Asset photo"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/photoNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_soft"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/photoAddBtn"
                            style="@style/ButtonPillQuiet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="42dp"
                            android:text="Add a photo"
                            app:icon="@drawable/ic_t_image"
                            app:iconSize="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/photoRemoveBtn"
                            style="@style/ButtonPillQuiet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:minHeight="42dp"
                            android:text="Remove"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== purchase and warranty ==================== -->
        <TextView style="@style/SectionLabel" android:text="Purchase &amp; warranty" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Purchased (YYYY-MM-DD)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/f_PurchaseDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Warranty (months)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/f_WarrantyMonths"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Price">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/f_Price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== status and assignment ==================== -->
        <TextView style="@style/SectionLabel" android:text="Status &amp; assignment" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="Status" />
                <com.itguy.assetmanager.ui.widget.AppSpinner android:id="@+id/f_Status" style="@style/Dropdown" />

                <TextView style="@style/FieldLabel" android:text="Employee name" />
                <com.itguy.assetmanager.ui.widget.AppSpinner android:id="@+id/f_EmployeeID" style="@style/Dropdown" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Signed by">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/f_ReceivedBy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Signed date (set at check out)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/f_NotesReceived"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:textColor="@color/text_soft" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/checkOutBtn"
                        style="@style/ButtonPillQuiet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Check out"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/checkInBtn"
                        style="@style/ButtonPillQuiet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Check in"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================== the note ========================== -->
        <TextView style="@style/SectionLabel" android:text="Note" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Internal note">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/f_Note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="3"
                        android:textColor="@color/text_strong" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== invoice or proof ===================== -->
        <TextView style="@style/SectionLabel" android:text="Invoice or proof" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/invoiceFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No file attached"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/invoicePickBtn"
                        style="@style/ButtonPillQuiet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Attach" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/invoiceViewBtn"
                        style="@style/ButtonPillQuiet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="View"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/invoiceRemoveBtn"
                        style="@style/ButtonPillQuiet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Remove"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/formError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_soft"
            android:padding="12dp"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteBtn"
                style="@style/ButtonPillQuiet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="Delete"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveBtn"
                style="@style/ButtonPill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/formProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
