<?xml version="1.0" encoding="utf-8"?>
<!-- One labelled text box in a settings section (label above, as on the web). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView android:id="@+id/rowLabel" style="@style/FieldLabel" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/rowBox"
        style="@style/Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/rowInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_strong" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/rowHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_soft"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
