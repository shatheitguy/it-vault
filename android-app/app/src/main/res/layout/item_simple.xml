<?xml version="1.0" encoding="utf-8"?>
<!--
  One row in any list that is not the asset list.

  It is the asset row, with the same card, the same dot, the same two lines
  and the same status pill — because a ticket, a contract and a person are all
  "a thing, the detail that identifies it, and what state it is in", and there
  was no reason for them to look like a different app.

  The dot and the pill are optional: a list of departments has no state, and
  rows in those lists simply hide both and keep the two lines.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:rippleColor="@color/chip_idle"
    app:strokeColor="@color/card_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp">

        <View
            android:id="@+id/lineDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lineTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_strong"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lineSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_soft"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/pill_idle"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/chip_idle_text"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/deleteBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete"
            android:src="@drawable/ic_trash"
            android:tint="@color/text_faint"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
