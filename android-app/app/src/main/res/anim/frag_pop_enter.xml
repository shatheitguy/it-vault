<?xml version="1.0" encoding="utf-8"?>
<!-- Material "fade through": incoming content fades + scales up very slightly.
     No large translate, so it stays smooth on long lists. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint">
    <alpha
        android:fromAlpha="0" android:toAlpha="1"
        android:startOffset="60" android:duration="220" />
    <scale
        android:fromXScale="0.96" android:toXScale="1.0"
        android:fromYScale="0.96" android:toYScale="1.0"
        android:pivotX="50%p" android:pivotY="50%p"
        android:startOffset="60" android:duration="260" />
</set>
