<?xml version="1.0" encoding="utf-8"?>
<!-- The crest on white, for a light home screen. Background is a colour
     rather than a PNG set: a flat tile does not need five densities. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_tile_light" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
