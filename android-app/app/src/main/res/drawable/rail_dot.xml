<?xml version="1.0" encoding="utf-8"?>
<!-- The small marker beside a timeline row. Hollow, so a filled one can mean
     "this is the current item" without inventing a second shape. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/card" />
    <stroke android:width="2dp" android:color="@color/rail" />
    <size android:width="10dp" android:height="10dp" />
</shape>
