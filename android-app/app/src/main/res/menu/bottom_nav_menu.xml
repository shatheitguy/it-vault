         devices on the network, the other reads the tag stuck to one. -->
    <item
        android:id="@+id/nav_scan"
        android:icon="@drawable/ic_wifi"
        android:title="Devices" />
    <item
        android:id="@+id/nav_qr"
        android:icon="@drawable/ic_qr"
        android:title="Scan QR" />
</menu>
