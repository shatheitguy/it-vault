<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the light/dark status-bar-icon flag actually needs to differ by
         mode. Every other item resolves through @color/xxx, which already
         picks the right value/values-night variant on its own. -->
    <style name="Theme.ItGuyAssets" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
