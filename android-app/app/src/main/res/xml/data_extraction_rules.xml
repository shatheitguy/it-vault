<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device.

  Android 12 and later ask an app to say what may be included in a cloud
  backup and in a device-to-device transfer. This app holds a server address
  and an API key, and the key is a credential for somebody's asset register:
  it is not worth carrying to another device to save re-typing a URL.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
