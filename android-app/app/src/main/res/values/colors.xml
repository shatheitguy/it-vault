<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 light palette (brand red accent kept) -->
    <color name="bg">#F5F7FB</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#EDF0F6</color>
    <color name="accent">#FF3B30</color>
    <color name="accent2">#C0392B</color>
    <color name="accent_container">#FFE3E0</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="text">#141B26</color>
    <color name="muted">#5C6A80</color>
    <color name="outline">#DCE1EA</color>
    <color name="bar_track">#E6EAF1</color>

    <!-- ===================== the redesign's shared tones =====================
         The reference design is built from four things: a tinted page, white
         cards floating on it with a lot of air, one saturated accent, and
         everything else in soft grey. These are the greys. The accent stays
         @color/accent, which an install's branding overwrites at run time —
         so the shape of the design is ours and the colour is theirs. -->

    <!-- the page behind the cards: a touch bluer and lighter than before, so
         a white card reads as raised without needing a heavy shadow -->
    <color name="page">#EEF1F8</color>
    <!-- a card's own fill, and the hairline that keeps it from dissolving
         into the page on a cheap screen -->
    <color name="card">#FFFFFF</color>
    <color name="card_line">#E8ECF4</color>
    <!-- input fields: a very light fill with no border, as in the reference -->
    <color name="field_fill">#F3F5FA</color>
    <color name="field_line">#DDE3EE</color>
    <!-- a pill that is not currently chosen -->
    <color name="chip_idle">#E9EDF6</color>
    <color name="chip_idle_text">#5C6A80</color>
    <!-- the row divider inside a card, and the timeline rail beside a list -->
    <color name="divider">#EFF2F8</color>
    <color name="rail">#DFE5F0</color>
    <!-- text, in three weights of attention -->
    <color name="text_strong">#101828</color>
    <color name="text_soft">#667085</color>
    <color name="text_faint">#98A2B3</color>
    <!-- The overview numbers, one role each, matching the web: total in the
         accent, checked out cyan, maintenance green, due soon amber, warranty
         red. Darkened here because the light surface needs it. -->
    <color name="stat_cyan">#0E8FB3</color>
    <color name="stat_green">#0F9D63</color>
    <color name="stat_amber">#B0761A</color>
    <color name="stat_red">#D24545</color>
    <!-- Heartbeat status. Chosen to stay legible on the light surface,
         which the web palette's neon greens do not. -->
    <color name="hb_up">#1FA971</color>
    <color name="hb_down">#E03B3B</color>
    <color name="hb_pending">#C07A10</color>
    <!-- Tiles for the alternative launcher icons. Flat colours, so the
         adaptive background needs no PNG set. -->
    <color name="icon_tile_light">#FFFFFFFF</color>
    <color name="icon_tile_mono">#FF0B0D12</color>
</resources>
