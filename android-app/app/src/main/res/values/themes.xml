<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Shared Material 3 base; the day/night variants only flip the status-bar icons. -->
    <style name="Base.Theme.ItGuyAssets" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <!-- Material tints a raised surface with the primary colour in
             proportion to its elevation, so on a red brand every card came
             out pink (measured: #FFF1F0 where #FFFFFF was asked for). A card
             should have a shadow, not a wash. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <!-- app-wide component defaults -->
        <item name="materialButtonStyle">@style/Button.IT</item>
        <item name="materialCardViewStyle">@style/Card</item>
        <item name="floatingActionButtonStyle">@style/FabPrimary</item>
    </style>

    <!-- FAB: white glyph on the accent circle. Without an explicit tint, M3 tints the
         icon with colorOnPrimaryContainer (our red) => an invisible red-on-red plus. -->
    <style name="FabPrimary" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/accent</item>
        <item name="tint">@color/on_accent</item>
    </style>

    <style name="Theme.ItGuyAssets" parent="Base.Theme.ItGuyAssets">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ============ Components ============ -->

    <style name="Button.IT" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="DarkInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/accent</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <style name="Toolbar.ItGuyAssets" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg</item>
        <item name="titleTextColor">@color/text</item>
        <item name="titleTextAppearance">@style/ToolbarTitle.IT</item>
    </style>

    <style name="ToolbarTitle.IT" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- Big screen heading. NB: no dot in the name — a dotted name would make
         Android look for an implicit parent style and fail to link. -->
    <style name="HeadingLarge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Rounded, outlined "widget" panel (matches the web dashboard cards) -->
    <style name="WidgetCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <!-- ==================== the redesign's components ====================
         Named for what they are rather than where they are used, because the
         same card appears on six screens and a style called DashboardCard
         would be a lie by the third. -->

    <!-- A card floating on the page. Elevation rather than a border is what
         makes the reference feel light; the hairline is only insurance for
         screens where a soft shadow disappears. -->
    <!-- Not the Material 3 elevated card: that one tints its own surface with
         the primary colour in proportion to its elevation, so on a red brand
         every card came out pink. A shadow should be a shadow. -->
    <style name="Card" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/card_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <!-- The screen's own title: big, tight, and not shouting in capitals. -->
    <style name="TitleXL">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_strong</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- A heading inside a card. -->
    <style name="TitleM">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_strong</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BodySoft">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_soft</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <!-- The field from the reference: a pale fill, a floating label, no box
         drawn around it. -->
    <style name="Field" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/field_fill</item>
        <item name="boxStrokeColor">@color/accent</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/text_soft</item>
        <item name="android:textColorHint">@color/text_faint</item>
    </style>

    <!-- The wide pill at the foot of a form. -->
    <style name="ButtonPill" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="ButtonPillQuiet" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14.5sp</item>
    </style>

    <!-- A filter pill. The background is swapped for pill_active when chosen. -->
    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/pill_idle</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/chip_idle_text</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="WidgetTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

</resources>
