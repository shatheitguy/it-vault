# --- runtime data / secrets: never commit real org data or credentials ---
itvault_config.json
.secret_key
.env
*.env
backups/
invoices/
logo.png
letterhead.png
logs/

# --- real / non-generic sample data ---
sample-assets.xlsx
screenshots/
legacy/
ui_backup_20260901/

# --- local-machine dev tooling (Windows-path-specific, not portable) ---
run_server.bat
start-itvault.bat
start_all.bat
itvault_spawn.py

# --- python ---
__pycache__/
*.egg-info/
*.egg-link
*.pyc
*.pyo
.venv/
venv/

# --- node (test deps only, no package.json tracked) ---
node_modules/

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local DB dumps (contain password hashes) — never commit
*_dump.sql

# Release APKs are attached to GitHub Releases, not committed
*.apk


# WhatsApp link (encrypted keys) -- on a source install the data folder is the
# code folder, so the linked phone's session lands next to bridge.mjs. Never commit it.
whatsapp/*.json
!whatsapp/package.json
!whatsapp/package-lock.json
.setup_done
