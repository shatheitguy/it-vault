# The installers are fetched raw and piped straight into a shell, so a CRLF
# in install.sh means "bad interpreter: /bin/sh^M" on every Linux box. Pin
# the line endings regardless of anyone's core.autocrlf setting.
install.sh text eol=lf
uninstall.sh text eol=lf
install.ps1 text eol=crlf
uninstall.ps1 text eol=crlf
