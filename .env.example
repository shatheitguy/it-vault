# Copy to .env and adjust before running `docker compose up` for real use.
# Every value below has a built-in default matching this file, so
# `docker compose up` works with zero setup for a quick local try — but
# change DB_PASS / DB_ROOT_PASS / ITGUY_SECRET / ITGUY_ADMIN_PASS before
# exposing this to anyone beyond your own machine.
DB_HOST=db
DB_PORT=3306
DB_NAME=itguy_assets
DB_USER=itguy
DB_PASS=itguypass
DB_ROOT_PASS=rootpass

# Flask session secret — CHANGE THIS in production
ITGUY_SECRET=change-me-in-prod

# First admin account (created on db init if no users exist)
ITGUY_ADMIN=admin
ITGUY_ADMIN_PASS=admin123
