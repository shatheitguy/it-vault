# Copy to .env and fill in your OWN values before `docker compose up`.
#
# There are deliberately no working defaults for the passwords below. A
# compose file that boots with well-known credentials means every install
# that skipped this step runs on passwords anyone can read in this repo.
# Compose will stop and name whichever one is missing.
#
# Generate strong values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

# --- database ---
DB_NAME=itvault
DB_USER=itvault
DB_PASS=
DB_ROOT_PASS=

# --- image version ---
# Pin a release for production; "latest" moves whenever one is published.
# See ghcr.io/shatheitguy/it-vault for available tags.
ITVAULT_TAG=latest

# --- first admin (OPTIONAL) ---
# Leave unset and the app comes up on its first-run setup wizard, where you
# pick the credentials interactively. Set these only for an unattended
# install, where the account is created without anyone visiting the wizard.
#ITVAULT_ADMIN=admin
#ITVAULT_ADMIN_PASS=

# --- session signing key (OPTIONAL) ---
# Leave unset. The app generates a strong random key on first start and
# keeps it in its data volume, which is safer than any value written here --
# a known secret lets anyone forge an admin session cookie. Set it only to
# share one key across multiple replicas.
#ITVAULT_SECRET=

# --- update checks (OPTIONAL) ---
# The release repo is built into the app, so this only matters for pointing
# a fork or private mirror somewhere else.
#ITVAULT_UPDATE_REPO=shatheitguy/it-vault

# The older ITGUY_SECRET / ITGUY_ADMIN / ITGUY_ADMIN_PASS names are still
# read when the ITVAULT_* ones are unset, so an existing .env keeps working
# on upgrade. Don't set both for the same setting -- ITVAULT_* wins.
