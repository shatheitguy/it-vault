# Copy to .env and fill in your own values, or leave the DB_* lines blank
# and enter them in the first-run setup wizard at /setup.
#
# IT-Vault does not ship a database. Install MariaDB/MySQL wherever suits
# you, create an empty database and a user with rights on it, and point the
# values below at it:
#
#   CREATE DATABASE itvault CHARACTER SET utf8mb4;
#   CREATE USER 'itvault'@'%' IDENTIFIED BY '<a-strong-password>';
#   GRANT ALL PRIVILEGES ON itvault.* TO 'itvault'@'%';
#
# The schema builds itself on first start and migrates itself on upgrade.

# --- your database ---
# For a MariaDB on the same machine as this container, use
# host.docker.internal. For one in another container, use its service name.
DB_HOST=
DB_PORT=3306
DB_NAME=itvault
DB_USER=
DB_PASS=

# --- image version ---
# Pin a release for production; "latest" moves whenever one is published.
# See ghcr.io/shatheitguy/it-vault for available tags.
ITVAULT_TAG=latest

# --- first admin (OPTIONAL) ---
# Leave unset and IT-Vault comes up on its first-run setup wizard, where you
# pick the credentials interactively. Set these only for an unattended
# install, where the account is created without anyone visiting the wizard.
#ITVAULT_ADMIN=admin
#ITVAULT_ADMIN_PASS=

# --- session signing key (OPTIONAL) ---
# Leave unset. A strong random key is generated on first start and kept in
# the data volume, which is safer than any value written here -- a known
# secret lets anyone forge an admin session cookie. Set it only to share one
# key across multiple replicas.
#ITVAULT_SECRET=

# --- update checks (OPTIONAL) ---
# The release repo is built in, so this only matters for pointing a fork or
# private mirror somewhere else.
#ITVAULT_UPDATE_REPO=shatheitguy/it-vault

# The older ITGUY_SECRET / ITGUY_ADMIN / ITGUY_ADMIN_PASS names are still
# read when the ITVAULT_* ones are unset, so an existing .env keeps working
# on upgrade. Don't set both for the same setting -- ITVAULT_* wins.
