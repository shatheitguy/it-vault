# Copy to .env and adjust before running `docker compose up` for real use.
# Every value below has a built-in default matching this file, so
# `docker compose up` works with zero setup for a quick local try — but
# change DB_PASS / DB_ROOT_PASS / ITVAULT_SECRET / ITVAULT_ADMIN_PASS before
# exposing this to anyone beyond your own machine.
DB_HOST=db
DB_PORT=3306
DB_NAME=itvault
DB_USER=itvault
DB_PASS=itvaultpass
DB_ROOT_PASS=rootpass

# Flask session secret — CHANGE THIS in production
ITVAULT_SECRET=change-me-in-prod

# First admin account (created on db init if no users exist)
ITVAULT_ADMIN=admin
ITVAULT_ADMIN_PASS=admin123

# The older ITGUY_SECRET / ITGUY_ADMIN / ITGUY_ADMIN_PASS names are still
# read if the ITVAULT_* ones above are unset, so an existing .env keeps
# working on upgrade. Keep using whichever pair you already have — but do
# not set both for the same setting, since the ITVAULT_* one wins.
